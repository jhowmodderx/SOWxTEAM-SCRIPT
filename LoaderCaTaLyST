                    local candidates={}
                    for _,server in ipairs(data.data or {})do
                        if eligible(server,maxPopulation,minPopulation)then candidates[#candidates+1]=server end
                    end
                    for i=#candidates,2,-1 do
                        local j=math.random(i);candidates[i],candidates[j]=candidates[j],candidates[i]
                    end
                    for _,server in ipairs(candidates)do
                        if eligible(server,maxPopulation,minPopulation)then
