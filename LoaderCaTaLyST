        if not(enabled and state.alive and state.farm)then return false end
        if playerLocks then
            local ok,blocked=pcall(function()return playerLocks:IsActive("Cutscene")or playerLocks:IsActive("Converse")or playerLocks:IsActive("Server")end)
            if ok and blocked then return false end
