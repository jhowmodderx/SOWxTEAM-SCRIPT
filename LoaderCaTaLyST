        if type(server) ~= "table" or type(server.id) ~= "string" or server.id == game.JobId then return false end
        local population, capacity = tonumber(server.playing), tonumber(server.maxPlayers)
        if not population or not capacity or population < 0 or population >= capacity then return false end
        if maxPopulation and population > maxPopulation then return false end
        if minPopulation and population<minPopulation then return false end
        return not shared.bad[server.id] or shared.bad[server.id] <= os.clock()
