local noclip = (function()
    local owners, saved = {}, {}
    local bound, added, removing, hold
    local function enabled() return state.alive and next(owners) ~= nil end
    local function restore()
        for part, value in pairs(saved) do pcall(function() part.CanCollide = value end) end
        saved = {}
        if hold then hold:Destroy(); hold = nil end
    end
    local function track(object)
        if enabled() and object:IsA("BasePart") and saved[object] == nil then
            saved[object] = object.CanCollide
            object.CanCollide = false
        end
    end
    local function bind(c)
        if added then added:Disconnect(); added = nil end
        if removing then removing:Disconnect(); removing = nil end
        restore()
        bound = c
        if not c then return end
        added = c.DescendantAdded:Connect(track)
        removing = c.DescendantRemoving:Connect(function(object)
            local original = saved[object]
            if original ~= nil then pcall(function() object.CanCollide = original end); saved[object] = nil end
        end)
        for _, object in ipairs(c:GetDescendants()) do track(object) end
    end
    table.insert(connections, player.CharacterAdded:Connect(function(c)
        if enabled() then bind(c) end
    end))
    table.insert(connections, RS.Stepped:Connect(function()
        if not enabled() then return end
        if player.Character ~= bound then bind(player.Character) end
        for part in pairs(saved) do
            if part.Parent and part.CanCollide then part.CanCollide = false end
        end
        -- O voo manual controla os tres eixos; evita disputar a sustentacao vertical.
        if owners.flight then if hold then hold:Destroy();hold=nil end;return end
        -- Sem colisao com o piso, sustenta o eixo vertical durante pausas do farm.
        local root = bound and bound:FindFirstChild("HumanoidRootPart")
        if root and (not hold or hold.Parent ~= root) then
            if hold then hold:Destroy() end
            hold = Instance.new("BodyVelocity")
            hold.Name, hold.MaxForce, hold.Velocity = "SOWxNoclipHold", Vector3.new(0, 1e9, 0), Vector3.zero
            hold.P, hold.Parent = 10000, root
        end
    end))
    local function set(owner, value)
        owners[owner] = value and true or nil
        if enabled() then
            if player.Character ~= bound or next(saved) == nil then bind(player.Character) end
        else bind(nil) end
    end
    return {set = set, stop = function() owners = {}; bind(nil) end}
end)()

