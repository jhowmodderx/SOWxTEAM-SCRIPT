local function probeLanding(destination, ceiling, flexible)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    local geometry = {workspace.Terrain}
    local map = workspace:FindFirstChild("Map")
    if map then table.insert(geometry, map) end
    params.FilterDescendantsInstances = geometry
    params.IgnoreWater = false
    params.RespectCanCollide = false
    local origin = Vector3.new(destination.X, ceiling and math.max(ceiling + 50, destination.Y + 60) or destination.Y + 60, destination.Z)
    local length = flexible and math.max(160, origin.Y - destination.Y + 250) or 160
    local result = workspace:Raycast(origin, Vector3.new(0, -length, 0), params)
    if not result or result.Material == Enum.Material.Water then return nil end
    if result.Instance and result.Instance.Name:lower():find("water", 1, true) then return nil end
    if result.Instance and result.Instance:IsA("BasePart") and not result.Instance.CanCollide then return nil end
    if not flexible and result.Position.Y < destination.Y - 30 then return nil end
    if result.Normal.Y < 0.5 then return nil end
    return Vector3.new(destination.X, flexible and result.Position.Y + 5 or math.max(destination.Y, result.Position.Y + 5), destination.Z)
end
local function findIslandLanding(route)
    for _, radius in ipairs({0, 40, 100, 200}) do
        for _, direction in ipairs({Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,0,1), Vector3.new(0,0,-1)}) do
            local point = route.destination + direction * radius
            local landing = probeLanding(point, route.altitude, true)
            if landing then return landing end
            if radius == 0 then break end
        end
    end
end
local function stepTravel(dt)
    local route = travel
    if not route then return end
    local _, hum, root = character()
    if not state.alive or root ~= route.root or not hum or hum.Health <= 0 then cancelTravel(); return end
    local now = os.clock()
    local waypoint
    if route.phase == "Local" then
        if route.searchLanding and now >= route.nextProbe then
            route.nextProbe = now + 1
            route.landing = findIslandLanding(route)
        end
        waypoint = route.searchLanding and (route.landing or root.Position) or route.destination
        if route.searchLanding and not route.landing then
            if now >= route.nextStream then
                route.nextStream = now + 5
                task.spawn(function() pcall(function() player:RequestStreamAroundAsync(route.destination, 3) end) end)
            end
            return
        end
        if (root.Position - waypoint).Magnitude < 2 then
            arrivedIsland = route.destinationIsland or arrivedIsland
            cancelTravel()
            return
        end
    elseif route.phase == "Subindo" then
        waypoint = Vector3.new(root.Position.X, route.altitude, root.Position.Z)
        if math.abs(root.Position.Y - route.altitude) < 2 then route.phase = "Atravessando" end
    elseif route.phase == "Atravessando" then
        waypoint = Vector3.new(route.destination.X, route.altitude, route.destination.Z)
        if now >= route.nextObstacle and (waypoint - root.Position).Magnitude > 5 then
            route.nextObstacle = now + 0.25
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Include
            params.FilterDescendantsInstances = {workspace:FindFirstChild("Map") or workspace.Terrain, workspace.Terrain}
            params.RespectCanCollide = true
            local delta = waypoint - root.Position
            local obstruction = workspace:Raycast(root.Position, delta.Unit * math.min(delta.Magnitude, 100), params)
            if obstruction then
                local raised=math.min(route.maxAltitude or route.altitude,route.altitude+50/0.28)
                if raised>route.altitude+0.1 then
                    route.altitude=raised;route.phase="Subindo";return
                end
            end
        end
        if (root.Position - waypoint).Magnitude < 3 then route.phase = "Aguardando solo" end
    elseif route.phase == "Aguardando solo" then
        waypoint = Vector3.new(route.destination.X, route.altitude, route.destination.Z)
        if now >= route.nextProbe then
            route.nextProbe = now + 1
            route.landing = route.searchLanding and findIslandLanding(route) or probeLanding(route.destination)
            if route.landing then route.phase = "Descendo" end
        end
    elseif route.phase == "Descendo" then
        if now >= route.nextProbe then
            route.nextProbe = now + 0.5
            local landing = route.searchLanding and probeLanding(route.landing, route.altitude, true) or probeLanding(route.destination)
            if not landing then route.phase = "Aguardando solo"; return end
            route.landing = landing
        end
        waypoint = route.landing
        if (root.Position - waypoint).Magnitude < 2 then
            arrivedIsland = route.destinationIsland or arrivedIsland
            cancelTravel(); return
        end
    end
    if now >= route.nextStream and (root.Position - route.destination).Magnitude < 1800 then
        route.nextStream = now + 5
        task.spawn(function() pcall(function() player:RequestStreamAroundAsync(route.destination, 3) end) end)
    end
    if waypoint then
        local remaining = (waypoint - root.Position).Magnitude
        if route.progressPhase ~= route.phase then
            route.progressPhase, route.bestRemaining, route.lastProgressAt = route.phase, remaining, now
        elseif remaining < route.bestRemaining - 1 then
            route.bestRemaining, route.lastProgressAt = remaining, now
        elseif route.owner ~= "collectibles" and route.owner ~= "manual" and now - route.lastProgressAt > 12 then
            if route.phase == "Aguardando solo" then
                route.landing = Vector3.new(route.destination.X, route.destination.Y + 5, route.destination.Z)
                route.phase = "Descendo"
                route.lastProgressAt = now
            else
                cancelTravel()
                return
            end
        end
        local delta = waypoint - root.Position
        local step = state.travelSpeed * math.min(dt, 0.1)
        local position = delta.Magnitude <= step and waypoint or root.Position + delta.Unit * step
        root.CFrame = CFrame.new(position) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

