                end
                status(brazilOnly and "Nenhum servidor brasileiro com vaga; tente novamente depois"or minPopulation and "Nenhum servidor novo com 6 a 10 jogadores e vaga nas paginas consultadas"or "Nenhum servidor com 0 ou 1 pessoa nas paginas consultadas")
