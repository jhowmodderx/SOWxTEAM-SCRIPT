do
    local function initialCapital(text)
        if type(text)~="string"or text==""then return text end
        local prefix,body=text:match("^(%s*)(.*)$")
        if body==""then return text end
        local code=utf8.codepoint(body,1)
        if (code>=97 and code<=122)or (code>=224 and code<=254 and code~=247)then
            local nextIndex=utf8.offset(body,2)or (#body+1)
            return prefix..utf8.char(code-32)..body:sub(nextIndex)
        end
        return text
    end
    local canvas=Window.Root:FindFirstAncestorOfClass("ScreenGui")or Window.Root
    local watched=setmetatable({},{__mode="k"})
    local function watch(object)
        if not(object:IsA("TextLabel")or object:IsA("TextButton"))or watched[object]then return end
        watched[object]=true
        local function update()
            pcall(function()
                local text=initialCapital(object.Text)
                if text~=object.Text then object.Text=text end
            end)
        end
        update()
        table.insert(connections,object:GetPropertyChangedSignal("Text"):Connect(update))
    end
    for _,object in ipairs(canvas:GetDescendants())do watch(object)end
    table.insert(connections,canvas.DescendantAdded:Connect(watch))
end
