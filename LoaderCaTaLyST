local serverHop = (function()
    local shared = env.SOWxServerRateLimit
    if type(shared) ~= "table" then shared = {nextAt = 0, streak = 0, cache = {}, bad = {}}; env.SOWxServerRateLimit = shared end
    shared.visited=shared.visited or {}
    if not shared.visitedLoaded then
        shared.visitedLoaded=true
        if type(readfile)=="function"and type(isfile)=="function"and isfile("sowxteam-servidores.json")then
            pcall(function()
                local saved=Http:JSONDecode(readfile("sowxteam-servidores.json"))
                if saved.placeId==game.PlaceId and type(saved.jobs)=="table"then shared.visited=saved.jobs end
            end)
        end
    end
    for id,time in pairs(shared.visited)do
        if type(time)~="number"or os.time()-time>21600 then shared.visited[id]=nil end
    end
    shared.visited[game.JobId]=os.time()
    local function isBrazil(location)
        if type(location)~="string"then return false end
        local country=location:match(",%s*([^,]+)%s*$")or location
        country=country:lower():match("^%s*(.-)%s*$")
        return country=="br"or country=="brazil"or country=="brasil"
    end
    local function nativeServers()
        local r=game:GetService("ReplicatedStorage")
        return require(r.Elysium.Modules.Library.ServerList).IsClient
    end
    local busy, serial, pendingId, pendingSerial = false, 0, nil, nil
    local message = "Pronto para buscar"
    local panel = internalStatus({Title = "Busca de servidor", Content = message:upper()})
    local function status(text)
        message = text
        if state.alive and not Fluent.Unloaded then pcall(function() panel:SetDesc(tostring(text):upper()) end) end
    end
    local function running(ticket) return serial == ticket and state.alive and not Fluent.Unloaded end
    local function waitUntil(deadline, ticket, reason)
        while os.clock() < deadline do
            if not running(ticket) then return false end
            status(reason .. " | aguardando " .. math.ceil(deadline - os.clock()) .. " s")
            task.wait(math.min(1, deadline - os.clock()))
        end
        return running(ticket)
    end
    local function retryAfter(headers)
        if type(headers) ~= "table" then return nil end
        for name, value in pairs(headers) do
            if tostring(name):lower() == "retry-after" then
                local seconds = tonumber(value)
                if seconds and seconds >= 0 then return seconds end
            end
        end
    end
    local function fetch(url, ticket)
        local cached = shared.cache[url]
        if cached and os.clock() - cached.time < 30 then return cached.data end
        for attempt = 1, 3 do
            if not waitUntil(shared.nextAt or 0, ticket, "Pausa entre consultas") then return nil end
            status("Consultando lista | tentativa " .. attempt .. "/3")
            local ok, result = pcall(function()
                local fn = type(request) == "function" and request or type(http_request) == "function" and http_request
                if fn then return fn({Url = url, Method = "GET"}) end
                return {StatusCode = 200, Body = game:HttpGet(url), Headers = {}}
            end)
            if not running(ticket) then return nil end
            local code = ok and type(result) == "table" and tonumber(result.StatusCode or result.Status) or 0
