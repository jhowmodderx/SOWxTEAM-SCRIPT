local function parseChance(value)
    if type(value) == "number" then return value end
    if type(value) == "string" then return tonumber(value:match("([%d%.]+)")) or 0 end
    return 0
end
local function refreshMaterialCatalog()
    refreshQuestCatalog(false)
    local found = {}
    local replicated = game:GetService("ReplicatedStorage")
    local infoRoot = replicated:FindFirstChild("Shared")
    for _, name in ipairs({"MainModules", "EnemysUtils", "EnemysInfo"}) do infoRoot = infoRoot and infoRoot:FindFirstChild(name) end
    local grinding = infoRoot and infoRoot:FindFirstChild("Grinding")
    local questsByTarget = {}
    for _, quest in ipairs(questCatalog) do
        for _, obj in ipairs(quest.objectives or {}) do
            questsByTarget[obj.target] = questsByTarget[obj.target] or {}
            table.insert(questsByTarget[obj.target], quest)
        end
    end
    if grinding then
        for index, module in ipairs(grinding:GetDescendants()) do
            if module:IsA("ModuleScript") then
                local enemyName = module.Name
                local quests = questsByTarget[enemyName]
                -- Ignora modulos de inimigos removidos/nao spawnados que nao pertencem a nenhuma quest real do jogo:
                if quests and #quests > 0 then
                    local ok, data = pcall(require, module)
                    local drops = ok and type(data) == "table" and type(data.Rewards) == "table" and data.Rewards.Drops
                    if type(drops) == "table" then
                        table.sort(quests, function(a, b) return a.minLevel < b.minLevel end)
                        local quest = quests[1]
                        local islandName = quest.island or (module.Parent and module.Parent.Name)
                        local level = type(data.EnemyArguments) == "table" and tonumber(data.EnemyArguments.Level) or quest.minLevel or 1
                        local altName = type(data.EnemyArguments) == "table" and data.EnemyArguments.AlternativeName
                        for matName, dropSpec in pairs(drops) do
                            if type(matName) == "string" and #matName > 0 then
                                local chance = type(dropSpec) == "table" and parseChance(dropSpec.Chance) or parseChance(dropSpec)
                                local entry = found[matName]
                                if not entry then
                                    entry = {name = matName, sources = {}, targets = {}}
                                    found[matName] = entry
                                end
                                entry.targets[enemyName] = true
                                if type(altName) == "string" and #altName > 0 then entry.targets[altName] = true end
                                table.insert(entry.sources, {
                                    enemy = enemyName,
                                    altName = type(altName) == "string" and #altName > 0 and altName or nil,
                                    island = islandName,
                                    level = level,
                                    chance = chance,
                                    quest = quest,
                                })
                            end
                        end
                    end
                end
            end
            if index % 25 == 0 then task.wait() end
        end
    end
    local names = {}
    for matName, entry in pairs(found) do
        table.sort(entry.sources, function(a, b)
            if math.abs((a.chance or 0) - (b.chance or 0)) > 0.01 then return (a.chance or 0) > (b.chance or 0) end
            return (a.level or 0) < (b.level or 0)
        end)
        entry.primary = entry.sources[1]
        table.insert(names, matName)
    end
    table.sort(names)
    if #names > 0 then
        materialCatalog, materialNames = found, names
        local sig = table.concat(names, "\0")
        if materialDropdown and sig ~= materialSignature then
            materialSignature = sig
            pcall(function() materialDropdown:SetValues(names) end)
        end
        if (not state.materialName or not materialCatalog[state.materialName]) and names[1] then
            state.materialName = names[1]
            if materialDropdown then pcall(function() materialDropdown:SetValue(names[1]) end) end
        end
    end
    return names
end
local function chooseMaterialSource(matEntry, level)
    if not matEntry or type(matEntry.sources) ~= "table" or #matEntry.sources == 0 then return nil end
    local bestEligible, bestAny
    for _, src in ipairs(matEntry.sources) do
        if not bestAny or (src.chance or 0) > (bestAny.chance or 0) then bestAny = src end
        if src.quest and level and level >= src.quest.minLevel then
            if not bestEligible or (src.chance or 0) > (bestEligible.chance or 0) then bestEligible = src end
        end
    end
    return bestEligible or matEntry.primary or bestAny
end
local materialStreamAt = 0
local function updateMaterialFarm()
    questReady = false
    local matName = state.materialName
    if (not matName or matName == "" or matName == "Carregando...") and materialDropdown and type(materialDropdown.Value) == "string" and materialDropdown.Value ~= "Carregando..." then
        matName = materialDropdown.Value
        state.materialName = matName
    end
    local matEntry = matName and materialCatalog[matName]
    if not matEntry then
        refreshMaterialCatalog()
        matName = state.materialName
        matEntry = matName and materialCatalog[matName]
    end
    if not matEntry then
        questNames = {}
        questPhase = "SELECIONE UM MATERIAL NA LISTA"
        return
    end
    local src = chooseMaterialSource(matEntry, currentLevel)
    if not src then
        questNames = {}
        questPhase = "SEM FONTE DE DROP PARA: " .. tostring(matName)
        return
    end
    local targetQuest = src.quest
    local island = src.island or (targetQuest and targetQuest.island)
    local canTakeQuest = state.materialQuest and targetQuest and currentLevel and currentLevel >= targetQuest.minLevel
    local modules = clientAPI()
    local data = modules.DataStore.IsClient:Get()
    local actives = data and data.Quests and data.Quests.Actives
    local hasTargetQuest = canTakeQuest and type(actives) == "table" and actives[targetQuest.id] ~= nil
    local activeGrindingQuest
    if type(actives) == "table" then
        for _, q in ipairs(questCatalog) do
            if actives[q.id] then activeGrindingQuest = q; break end
        end
    end
    -- Se pode pegar a quest do material e nao tem outra quest de outra ilha trancando (ou nenhuma ativa), vai pegar a quest:
    if canTakeQuest and type(actives) == "table" and not hasTargetQuest and not activeGrindingQuest then
        local npc, position = questGiver(targetQuest)
        local _, hum, root = character()
        if not hum or hum.Health <= 0 or not root then questPhase = "Aguardando personagem"; return end
        if not position or (root.Position - position).Magnitude > 12 then
            approachQuestGiver(targetQuest)
            questPhase = "MATERIAL (" .. matName .. "): INDO ACEITAR MISSAO " .. targetQuest.id
            return
        end
        if os.clock() >= questCooldown and not UIS:GetFocusedTextBox() then
            if not npc then
                questPhase = "MATERIAL (" .. matName .. "): AGUARDANDO QUEST GIVER CARREGAR"
                pcall(function() player:RequestStreamAroundAsync(position, 2) end)
                questCooldown = os.clock() + 2
                return
            end
            remoteEvent("Quests"):FireServer("AcceptGrinding", targetQuest.id)
            nextCache = 0
            questPhase = "MATERIAL (" .. matName .. "): ACEITANDO MISSAO " .. targetQuest.id
            questCooldown = os.clock() + 3.5
            return
        end
    end
    -- Define os alvos que dropam o material
    local targets = {}
    for _,source in ipairs(matEntry.sources)do
        if source.island==src.island then
            targets[source.enemy]=true
            if source.altName then targets[source.altName]=true end
        end
    end
    -- Preserve alternative names only for the selected island's sources.
    for _,model in ipairs(cachedEnemies)do
        local native=model:GetAttribute("OriginalName")
        if native and targets[native]then targets[original(model)]=true end
    end
    if hasTargetQuest then
        local pending, found = pendingObjectives(targetQuest)
        if found and next(pending) ~= nil then
            local filtered = {}
            for enemyName in pairs(pending) do
                if matEntry.targets[enemyName] then filtered[enemyName] = true end
            end
            if next(filtered) ~= nil then targets = filtered else targets = pending end
        end
    end
    questNames = targets
    local _, _, ownRoot = character()
    local nearest, nearestSpawn, spawnPosition = math.huge, math.huge, nil
    local function scanEnemy(model)
        if model.Parent and targets[original(model)] and ownRoot and model:GetAttribute("Dead") ~= true then
            local health = enemyHealth(model)
            local enemyRoot = model:FindFirstChild("HumanoidRootPart")
            -- Ignora modelos template escondidos no void (Y < -500) ou mortos
            if enemyRoot and health and health > 0 and enemyRoot.Position.Y > -500 then
                local distance = (ownRoot.Position - enemyRoot.Position).Magnitude
                if valid(model) then nearest = math.min(nearest, distance) end
                if distance < nearestSpawn then nearestSpawn, spawnPosition = distance, enemyRoot.Position end
            end
        end
    end
    for _, model in ipairs(cachedEnemies) do scanEnemy(model) end
    if nearest == math.huge and not spawnPosition then
        local folder = enemiesFolder()
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then scanEnemy(obj) end
            end
        end
        if spawnPosition then refreshLists() end
    end
    -- Se existe inimigo vivo e renderizado no mapa, libera o combate imediatamente!
    if nearest < math.huge then
        questReady = true
        questPhase = "FARM MATERIAL: " .. matName .. " | ALVO: " .. src.enemy .. (hasTargetQuest and (" | MISSAO: " .. targetQuest.id) or "")
        return
    end
    -- Se o inimigo existe mas esta com Render=false ou longe, voa bem perto do spawn dele para ativar o Render:
    if ownRoot and spawnPosition then
        if nearestSpawn > 18 then
            beginTravel(spawnPosition + Vector3.new(0, 2, 5), "Material " .. matName .. " (" .. src.enemy .. ")", "farm", island)
            questPhase = "MATERIAL (" .. matName .. "): INDO CARREGAR " .. src.enemy
            return
        end
        if os.clock() >= materialStreamAt then
            materialStreamAt = os.clock() + 1.5
            task.spawn(function() pcall(function() player:RequestStreamAroundAsync(spawnPosition, 3) end) end)
            refreshLists()
        end
        questPhase = "MATERIAL (" .. matName .. "): RENDERIZANDO " .. src.enemy
        return
    end
    -- Se nenhum inimigo desse material esta carregado no cliente ainda, viaja ate o Quest Giver ou centro da ilha do material:
    local giverPosition
    if targetQuest then local npc; npc, giverPosition = questGiver(targetQuest) end
    local islandPos = giverPosition or (island and islandPosition(island))
    if ownRoot and islandPos then
        local horizontal = (Vector3.new(ownRoot.Position.X, 0, ownRoot.Position.Z) - Vector3.new(islandPos.X, 0, islandPos.Z)).Magnitude
        if horizontal > 180 or math.abs(ownRoot.Position.Y - islandPos.Y) > 250 then
            if targetQuest and giverPosition then
                beginTravel(giverPosition + Vector3.new(0, 5, 6), "Ilha " .. tostring(island) .. " (" .. matName .. ")", "farm", island)
            else
                beginTravel(islandPos + Vector3.new(0, 5, 0), "Ilha " .. tostring(island) .. " (" .. matName .. ")", "farm", island, true)
            end
            questPhase = "MATERIAL (" .. matName .. "): VIAJANDO PARA " .. tostring(island)
            return
        end
        if os.clock() >= materialStreamAt then
            materialStreamAt = os.clock() + 3
            task.spawn(function() pcall(function() player:RequestStreamAroundAsync(islandPos, 3) end) end)
            refreshLists()
        end
    end
    questReady = true
    questPhase = "MATERIAL (" .. matName .. "): AGUARDANDO SPAWN DE " .. src.enemy .. " EM " .. tostring(island)
end
local function updateQuest()
    questReady = false
    if state.bossMode then return end
    if state.materialFarm then
        quietQuestHUD(true)
        if travel then questPhase = travel.phase .. ": " .. travel.label; return end
        updateMaterialFarm()
        return
    end
    if not state.quests then questPhase = travel and (travel.phase .. ": " .. travel.label) or "Farm desligado"; return end
    quietQuestHUD(true)
    if travel then questPhase = travel.phase .. ": " .. travel.label; return end
    local modules = clientAPI()
    local data = modules.DataStore.IsClient:Get()
    if not data or not data.Quests or type(data.Quests.Actives) ~= "table" then questPhase = "Aguardando dados de quests do servidor"; return end
    -- O jogo impede aceitar outra grinding quest. Termina a ativa antes de trocar.
    local activeQuest
    for _, quest in ipairs(questCatalog) do
        if data.Quests.Actives[quest.id] then activeQuest = quest; break end
    end
    desiredQuest = activeQuest or chooseQuest(currentLevel)
    if not desiredQuest then questNames = {}; questPhase = "Aguardando nivel e catalogo"; return end
    if activeQuest then
        local pending, found = pendingObjectives(activeQuest)
        if not found then for _, objective in ipairs(activeQuest.objectives) do pending[objective.target] = true end end
        questNames = pending
        local _, _, ownRoot = character()
        local nearest, nearestSpawn, spawnPosition = math.huge, math.huge, nil
        for _, model in ipairs(cachedEnemies) do
            if model.Parent and pending[original(model)] and ownRoot then
                local enemyRoot = model:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    local distance = (ownRoot.Position - enemyRoot.Position).Magnitude
                    if valid(model) then nearest = math.min(nearest, distance) end
                    if distance < nearestSpawn then nearestSpawn, spawnPosition = distance, enemyRoot.Position end
                end
            end
        end
        -- Render=false nao serve para atacar, mas o ponto conhecido permite chegar a area e carregar o mob.
        if ownRoot and nearest == math.huge and spawnPosition and nearestSpawn > 25 then
            beginTravel(spawnPosition + Vector3.new(0, 5, 8), "Carregando alvos da quest", "farm", activeQuest.island)
            questPhase = "Quest aceita; indo carregar os inimigos"
            return
        end
        local _, giverPosition = questGiver(activeQuest)
        if ownRoot and nearest > 3000 and (not giverPosition or (ownRoot.Position - giverPosition).Magnitude > 1500) then
            approachQuestGiver(activeQuest)
            questPhase = "Retornando para a ilha da quest: " .. activeQuest.island
            return
        end
        questReady = next(pending) ~= nil
        lastAcceptedQuest, repeatAttempted, completionHandled = activeQuest.id, false, nil
        questPhase = "Servidor confirmou quest: " .. activeQuest.id
        return
    end
    questNames = {}
    if lastAcceptedQuest and completionHandled ~= lastAcceptedQuest then
        completionHandled, questCooldown, nextCache, target = lastAcceptedQuest, 0, 0, nil
    end
    if os.clock() < questCooldown or UIS:GetFocusedTextBox() then return end
    local npc, position = questGiver(desiredQuest)
    local _, hum, root = character()
    if not hum or hum.Health <= 0 or not root then questPhase = "Aguardando personagem"; return end
    if not position or (root.Position - position).Magnitude > 12 then
        approachQuestGiver(desiredQuest)
        return
    end
    if not npc then
        questPhase = "No destino, aguardando modelo do Quest Giver carregar"
        pcall(function() player:RequestStreamAroundAsync(position, 2) end)
        questCooldown = os.clock() + 2
        return
    end
    -- AcceptGrinding depende de nivel/proximidade; nao abre o quadro nem o dialogo.
    remoteEvent("Quests"):FireServer("AcceptGrinding", desiredQuest.id)
    nextCache = 0
    questPhase = "AcceptGrinding enviado; aguardando servidor: " .. desiredQuest.id
    questCooldown = os.clock() + 4
end

