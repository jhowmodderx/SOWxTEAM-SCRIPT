local function questRow(id, data, islandHint)
    if type(id) ~= "string" or type(data) ~= "table" or not data.GrindingQuest
        or type(data.Arguments) ~= "table" or data.Arguments.IsBoss
        or type(data.MinLevel) ~= "number" or type(data.Arguments.Giver) ~= "string" then return nil end
