local function validateConfig(values)
    assert(type(values) == "table", "Configuracoes invalidas.")
    for _, spec in ipairs(configSpec) do
        local value = values[spec[1]]
        if value ~= nil then
            assert(type(value) == spec[2], "Tipo invalido: " .. spec[1])
            if spec[2] == "number" then
                assert(value == value and value >= spec[3] and value <= spec[4], "Valor fora do intervalo: " .. spec[1])
            elseif spec[2] == "table" then
                for key, selected in pairs(value) do
                    assert(type(key)=="string" and #key<=100 and type(selected)=="boolean", "Selecao invalida na configuracao.")
                    if spec[1]=="Skills" then assert(table.find({"Z","X","C","V","F"},key),"Skill invalida") end
                    if spec[1]=="AutoStatTargets" then assert(table.find({"força","resistência","espada","arma","fruta vox"},key),"Atributo invalido") end
                end
            elseif spec[2] == "string" then
                assert(#value > 0 and #value <= 100, "Texto invalido: " .. spec[1])
                if spec[3] then assert(table.find(spec[3], value), "Opcao desconhecida: " .. spec[1]) end
            end
        end
    end
end
