bossGuardian=(function()
    local enabled,control,recovering,returning=false,false,false,false
    local api,previousShow,previousClear,showWrapper,clearWrapper,playerLocks
    local cues={};local lastBoss,lastPosition,lastLocation,lastRoot,lastCharacter
    local nextDecision,safePoint=0,nil
    local info={phase="DESLIGADO",warnings=0,dodges=0,returns=0}
