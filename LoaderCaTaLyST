local bossNames, bossPositions, bossListSignature = {}, {}, ""
local function refreshBosses()
    local found, names = {}, {"mais próximo"}
    for _, model in ipairs(cachedEnemies) do
        if model.Parent and model:GetAttribute("IsBoss") == true then
            local name = original(model)
            found[name] = true
            local root = model:FindFirstChild("HumanoidRootPart")
            if root then bossPositions[name] = root.Position end
        end
    end
    for name in pairs(bossPositions) do found[name] = true end
    for name in pairs(found) do table.insert(names, name) end
    table.sort(names, function(a,b) if a==b then return false elseif a=='mais próximo' then return true elseif b=='mais próximo' then return false end;return a<b end)
    return names
end
