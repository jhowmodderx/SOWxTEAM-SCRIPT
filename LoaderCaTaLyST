local nextCatalogRead = 0
local function refreshQuestCatalog(force)
    if not force and os.clock() < nextCatalogRead then return end
    nextCatalogRead = os.clock() + 60
    local replicated = game:GetService("ReplicatedStorage")
    local node = replicated
    for _, name in ipairs({"Shared", "MainModules", "ProgressUtils", "QuestsInfo"}) do node = node and node:FindFirstChild(name) end
    if not node then questCatalogStatus.error = "QUESTSINFO NAO CARREGADO"; summarizeCatalog(); return end
    -- A mesma tabela consolidada enumerada pelo QuestBoard nativo, sem limite superior de nivel.
    local ok, live = pcall(require, node)
    local rows = {}
    if ok and type(live) == "table" then
        for id, data in pairs(live) do
            local row = questRow(id, data)
            if row then table.insert(rows, row) end
        end
    end
    if #rows > 0 then
        table.sort(rows, function(a,b) if a.minLevel ~= b.minLevel then return a.minLevel < b.minLevel end;return a.id < b.id end)
        questCatalog, catalogIndex = rows, {}
        for index, quest in ipairs(rows) do catalogIndex[quest.id] = index end
        questCatalogStatus.source, questCatalogStatus.error = "JOGO", nil
        summarizeCatalog()
        return
    end
    questCatalogStatus.error = ok and "CATALOGO CONSOLIDADO INDISPONIVEL; USANDO MODULOS LOCAIS" or tostring(live)
    local grinding = node:FindFirstChild("Grinding")
    if grinding then
        for index, module in ipairs(grinding:GetDescendants()) do
            if not state.alive then return end
            if module:IsA("ModuleScript") then
                local success, data = pcall(require, module)
                local row = success and questRow(module.Name, data, module.Parent.Name)
                if row then
                    local position = catalogIndex[row.id]
                    if position then questCatalog[position] = row else table.insert(questCatalog, row);catalogIndex[row.id] = #questCatalog end
                    questCatalogStatus.source = "MODULOS DO JOGO"
                end
            end
            if index % 20 == 0 then task.wait() end
        end
    end
    summarizeCatalog()
end
