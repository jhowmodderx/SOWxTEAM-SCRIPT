-- SOWxTEAM minimal animated loader. The main script remains at the URL below.
-- Requires a client executor with HTTP access and loadstring.
local SCRIPT_URL="https://raw.githubusercontent.com/heverttonrodrigo113-dot/sowxteam/refs/heads/main/sowxteam"
local INTRO_SECONDS=3.4
local DOWNLOAD_TIMEOUT=25

local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
assert(player,"SOWxTEAM: execute dentro do jogo.")
local env=(getgenv and getgenv())or _G
if env.SOWxTEAMIntro and type(env.SOWxTEAMIntro.cancel)=="function"then pcall(env.SOWxTEAMIntro.cancel)end
local session={alive=true,epoch=0,executed=false}
env.SOWxTEAMIntro=session
local connections,tweens={},{}
local gui
local function cleanup()
    if not session.alive then return end
    session.alive=false;session.epoch=session.epoch+1
    for _,c in ipairs(connections)do pcall(c.Disconnect,c)end
    for _,t in ipairs(tweens)do pcall(t.Cancel,t)end
    if gui then gui:Destroy()end
    if env.SOWxTEAMIntro==session then env.SOWxTEAMIntro=nil end
end
session.cancel=cleanup

local function new(class,properties,parent)
    local object=Instance.new(class)
    for key,value in pairs(properties or {})do object[key]=value end
    object.Parent=parent
    return object
end
local function round(object,radius)new("UICorner",{CornerRadius=UDim.new(0,radius)},object)end
local function tween(object,duration,properties,delay)
    local t=TweenService:Create(object,TweenInfo.new(duration,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,0,false,delay or 0),properties)
    tweens[#tweens+1]=t;t:Play();return t
end
local white=Color3.fromRGB(245,240,255)
local purple=Color3.fromRGB(174,101,255)
local muted=Color3.fromRGB(167,154,190)
gui=new("ScreenGui",{Name="SOWxTEAMIntro",IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=100000,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
local attached=false
local function attach(parent)
    if not parent then return end
    local ok=pcall(function()gui.Parent=parent end)
    if ok and gui.Parent then attached=true end
end
if type(gethui)=="function"then local ok,parent=pcall(gethui);if ok then attach(parent)end end
if not attached then local ok,parent=pcall(game.GetService,game,"CoreGui");if ok then attach(parent)end end
if not attached then attach(player:FindFirstChildOfClass("PlayerGui")or player:WaitForChild("PlayerGui",5))end
if not attached then cleanup();error("SOWxTEAM: nao foi possivel mostrar a introducao.")end

local backdrop=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(5,3,12),BackgroundTransparency=1,BorderSizePixel=0},gui)
local anchor=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(480,230),BackgroundTransparency=1},backdrop)
local scale=new("UIScale",{Scale=1},anchor)
local function resize()
    local camera=workspace.CurrentCamera
    local viewport=camera and camera.ViewportSize or Vector2.new(800,600)
    scale.Scale=math.clamp(math.min((viewport.X-32)/480,(viewport.Y-48)/230),.3,1)
end
resize()
local camera=workspace.CurrentCamera
if camera then connections[#connections+1]=camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)end
connections[#connections+1]=workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(resize)

local glows={}
for i=1,2 do
    local glow=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.48),Size=UDim2.fromOffset(480+i*14,220+i*12),BackgroundColor3=Color3.fromRGB(118,45,190),BackgroundTransparency=.965+i*.004,BorderSizePixel=0},anchor)
    round(glow,90);glows[i]=glow
end
local card=new("Frame",{Size=UDim2.fromScale(1,1),Position=UDim2.fromOffset(0,24),BackgroundColor3=Color3.fromRGB(18,12,31),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true},anchor)
round(card,20)
local border=new("UIStroke",{Color=Color3.fromRGB(134,81,191),Thickness=1,Transparency=1},card)
new("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(34,20,53)),ColorSequenceKeypoint.new(1,Color3.fromRGB(12,10,24))}),Rotation=35},card)
local accent=new("Frame",{Position=UDim2.new(0,60,0,0),Size=UDim2.new(1,-120,0,2),BackgroundColor3=white,BorderSizePixel=0},card)
new("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(60,27,101)),ColorSequenceKeypoint.new(.5,purple),ColorSequenceKeypoint.new(1,Color3.fromRGB(60,27,101))}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.5,0),NumberSequenceKeypoint.new(1,1)})},accent)

local labels={}
local function text(properties)
    properties.BackgroundTransparency=1;properties.TextTransparency=1
    local label=new("TextLabel",properties,card);labels[#labels+1]=label;return label
end
local title=text({Position=UDim2.new(0,20,0,63),Size=UDim2.new(1,-40,0,48),Text="SOWxTEAM",Font=Enum.Font.GothamBlack,TextSize=42,TextColor3=white})
local titleGradient=new("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(232,213,255)),ColorSequenceKeypoint.new(.43,white),ColorSequenceKeypoint.new(.7,Color3.fromRGB(185,125,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(124,74,222))}),Rotation=0},title)
text({Position=UDim2.new(0,20,0,113),Size=UDim2.new(1,-40,0,21),Text="Bem-vindo",Font=Enum.Font.GothamMedium,TextSize=10,TextColor3=muted})
local status=text({Position=UDim2.new(0,40,0,148),Size=UDim2.new(1,-80,0,20),Text="Preparando sua experiência",Font=Enum.Font.Gotham,TextSize=12,TextColor3=Color3.fromRGB(200,187,222)})
local rail=new("Frame",{Position=UDim2.new(0,60,0,181),Size=UDim2.new(1,-120,0,3),BackgroundColor3=Color3.fromRGB(50,35,68),BorderSizePixel=0},card)
round(rail,6)
local fill=new("Frame",{Size=UDim2.fromScale(0,1),BackgroundColor3=white,BorderSizePixel=0},rail)
round(fill,6)
new("UIGradient",{Color=ColorSequence.new(Color3.fromRGB(118,63,224),Color3.fromRGB(216,158,255))},fill)
local close=new("TextButton",{Position=UDim2.new(1,-39,0,12),Size=UDim2.fromOffset(26,26),BackgroundTransparency=1,Text="×",TextColor3=muted,Font=Enum.Font.Gotham,TextSize=22,AutoButtonColor=false},card)
connections[#connections+1]=close.Activated:Connect(cleanup)

local started=os.clock()
local progress,targetProgress=0,.15
connections[#connections+1]=RunService.RenderStepped:Connect(function(dt)
    if not session.alive then return end
    local elapsed=os.clock()-started
    local pulse=.5+.5*math.sin(elapsed*1.8)
    titleGradient.Offset=Vector2.new(math.sin(elapsed*.7)*.045,0)
    for i,g in ipairs(glows)do g.BackgroundTransparency=math.clamp(.965+i*.004+pulse*.004,0,1)end
    progress=progress+(targetProgress-progress)*math.min(1,dt*5)
    fill.Size=UDim2.fromScale(progress,1)
end)
tween(backdrop,.6,{BackgroundTransparency=.4})
tween(card,.7,{BackgroundTransparency=.02,Position=UDim2.fromOffset(0,0)})
tween(border,.8,{Transparency=.35})
for i,label in ipairs(labels)do tween(label,.65,{TextTransparency=0},.25+i*.09)end

local function validateSource(source)
    if type(source)~="string"or #source<8 then return nil,"O link retornou um arquivo vazio."end
    if #source>12*1024*1024 then return nil,"O arquivo ultrapassa o limite do carregador."end
    source=source:gsub("^\239\187\191","")
    local head=source:sub(1,256):lower()
    if head:match("^%s*<!doctype")or head:match("^%s*<html")then return nil,"O link retornou uma página, não um script raw."end
    return source
end
local function downloadSource()
    local ok,body=pcall(function()return game:HttpGet(SCRIPT_URL)end)
    if ok then
        local source,reason=validateSource(body)
        if source then return source end
        body=reason
    end
    local requestFunction=request or http_request or(syn and syn.request)or(http and http.request)
    if type(requestFunction)=="function"then
        local success,response=pcall(requestFunction,{Url=SCRIPT_URL,Method="GET"})
        if success and type(response)=="table"then
            local code=tonumber(response.StatusCode or response.Status)
            if code and code>=200 and code<300 then return validateSource(response.Body)end
            return nil,"O servidor não entregou o arquivo. Tente novamente."
        end
    end
    return nil,"Não foi possível acessar o script neste executor."
end
local function compileSource(source)
    if type(loadstring)~="function"then return nil,"Este executor não oferece loadstring."end
    local ok,chunk,reason=pcall(loadstring,source,"SOWxTEAM/main")
    if not ok or type(chunk)~="function"then return nil,"O script principal não pôde ser compilado.",tostring(reason or chunk)end
    return chunk
end
local function showFailure(message,detail)
    if not session.alive then return end
    targetProgress=0;status.Text=message;status.TextColor3=Color3.fromRGB(255,174,195)
    warn("SOWxTEAM loader: "..tostring(detail or message))
    local button=new("TextButton",{Position=UDim2.new(.5,-75,0,193),Size=UDim2.fromOffset(150,26),BackgroundColor3=Color3.fromRGB(79,40,121),Text="Tentar novamente",TextColor3=white,TextSize=11,Font=Enum.Font.GothamMedium,BorderSizePixel=0},card)
    round(button,8)
    connections[#connections+1]=button.Activated:Connect(function()
        button:Destroy()
        if session.retry then session.retry()end
    end)
end
local function begin()
    if not session.alive or session.executed then return end
    session.epoch=session.epoch+1
    local epoch=session.epoch
    local result={done=false}
    local attemptAt=os.clock()
    targetProgress=.55;status.Text="Conectando ao SOWxTEAM";status.TextColor3=Color3.fromRGB(200,187,222)
    task.spawn(function()
        local source,reason=downloadSource()
        if not session.alive or epoch~=session.epoch then return end
        if source then result.chunk,result.reason,result.detail=compileSource(source)else result.reason=reason end
        result.done=true
    end)
    task.spawn(function()
        while session.alive and epoch==session.epoch and not result.done and os.clock()-attemptAt<DOWNLOAD_TIMEOUT do task.wait(.05)end
        if not session.alive or epoch~=session.epoch then return end
        if not result.done then session.epoch=session.epoch+1;showFailure("A conexão demorou demais. Tente novamente.");return end
        if not result.chunk then showFailure(result.reason or "Não foi possível carregar.",result.detail);return end
        targetProgress=.88;status.Text="Preparando sua experiência"
        while session.alive and epoch==session.epoch and os.clock()-started<INTRO_SECONDS do task.wait(.05)end
        if not session.alive or epoch~=session.epoch then return end
        targetProgress=1;status.Text="Tudo pronto. Aproveite!"
        task.wait(.4)
        if not session.alive or epoch~=session.epoch then return end
        tween(backdrop,.35,{BackgroundTransparency=1})
        tween(card,.35,{Position=UDim2.fromOffset(0,-18),BackgroundTransparency=1})
        for _,label in ipairs(labels)do tween(label,.25,{TextTransparency=1})end
        task.wait(.35)
        if not session.alive or epoch~=session.epoch then return end
        session.executed=true
        local chunk=result.chunk
        cleanup()
        local success,reason=pcall(chunk)
        if not success then
            warn("SOWxTEAM main: "..tostring(reason))
            pcall(function()game:GetService("StarterGui"):SetCore("SendNotification",{Title="SOWxTEAM",Text="A introdução terminou, mas o script principal encontrou um erro.",Duration=7})end)
        end
    end)
end
session.retry=begin
begin()
return session
