    end
    local function now()return workspace:GetServerTimeNow()end
    local function direction(wire)
        local value=wire.Direction;local length=math.sqrt(value.X*value.X+value.Z*value.Z)
        if length<0.001 then return 0,-1 end
        return value.X/length,value.Z/length
    end
    local function contains(wire,point,margin)
        local dx,dz=point.X-wire.Center.X,point.Z-wire.Center.Z
