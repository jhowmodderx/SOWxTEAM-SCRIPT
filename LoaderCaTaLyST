islandPosition=function(name)
    local area = areaObjects[name]
    if not area or not area.Parent then
        local map = workspace:FindFirstChild("Map")
        local areas = map and map:FindFirstChild("Areas")
        area = areas and areas:FindFirstChild(name)
    end
    if not area then return islandDestinations[name]or islandAnchors[name]or regionIslandPoint(name)end
    local center=area:GetAttribute("MapCenter")or area:GetAttribute("MapPosition")or area:GetAttribute("Center")
    if typeof(center) == "Vector3" then
        local altitude = tonumber(area:GetAttribute("MapAltitude")) or center.Y
        local arrival = Vector3.new(center.X, altitude + 10, center.Z)
        islandAnchors[name] = arrival
        return arrival
    end
    if islandDestinations[name] then return islandDestinations[name] end
    local best, score = nil, 0
    for index, object in ipairs(area:GetDescendants()) do
        if object:IsA("SpawnLocation") then return object.Position end
        if object:IsA("BasePart") and object.Anchored and object.CanCollide then
            local size = object.Size
            local lowerName = object.Name:lower()
            local surface = size.X * size.Z
            if size.X >= 8 and size.Z >= 8 and size.Y <= math.max(size.X, size.Z)
                and not lowerName:find("water", 1, true) and not lowerName:find("ocean", 1, true)
                and surface > score then best, score = object, surface end
        end
        if index % 300 == 0 then task.wait() end
    end
    if best then
        local top = best.CFrame:PointToWorldSpace(Vector3.new(0, best.Size.Y / 2, 0))
        return top
    end
    if area:IsA("Model")and area:FindFirstChildWhichIsA("BasePart",true)then
        local frame,size=area:GetBoundingBox()
        return Vector3.new(frame.Position.X,frame.Position.Y+size.Y/2,frame.Position.Z)
    end
    return regionIslandPoint(name)or islandAnchors[name]
end
