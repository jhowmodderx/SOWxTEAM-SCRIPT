    elseif data.options.SeaBeastFarm==true and Fluent.Options.SeaBeastFarm then Fluent.Options.SeaBeastFarm:SetValue(true)
    elseif data.options.SeaBeastOnly==true and Fluent.Options.SeaBeastOnly then Fluent.Options.SeaBeastOnly:SetValue(true)
    elseif data.options.FishingFarm==true then Fluent.Options.FishingFarm:SetValue(true)
    elseif data.options.StoryFarm==true then
        if Fluent.Options.FarmMode then Fluent.Options.FarmMode:SetValue("História") end
        farmControl:SetValue(true)
    elseif data.options.BossFarm == true then bossControl:SetValue(true)
    elseif data.options.MaterialFarm == true and materialControl then materialControl:SetValue(true)
    elseif data.options.FarmAutomatico == true then farmControl:SetValue(true) end
    if not quiet then notify("Configuracoes carregadas.") end
end
local function configAction(fn)
    if configBusy then return end
    configBusy = true
    task.spawn(function()
        local ok=guard("Configuracoes", fn)
        configBusy = false
        if not ok then pcall(notify,"ERRO NAS CONFIGURACOES: "..tostring(lastFailure or "Consulte o registro automático"))end
    end)
end
