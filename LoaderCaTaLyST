        local text=message:lower():gsub("<[^>]+>","")
        if text:find("skill cooldown",1,true)or text:find("attack cooldown",1,true)or text:find("recarga da habilidade",1,true)then return false end
        local confirmed=type(remaining)=="number"and remaining>0
            or text:find("cooldown",1,true)or text:find("cool down",1,true)
            or text:find("the arena is still in use",1,true)
            or text:find("a arena ainda esta em uso",1,true)
            or text:match("come back in %d+ seconds")or text:match("come back in %d+:%d%d")
            or text:match("volte em %d+:%d%d")or text:match("retorne em %d+:%d%d")
        if not confirmed then return false end
        stopStory()
        if storyToggle and storyToggle.Value then pcall(function()storyToggle:SetValue(false)end)end
        info.cooldown=message;info.cooldownRemaining=remaining
        setPhase("FARM PARADO: COOLDOWN DA MISSAO : "..message)
        local content="COOLDOWN DA MISSAO: "..message.." | FARM HISTORIA PARADO"
        local shown=pcall(notify,content)
        if not shown then
            pcall(function()game:GetService("StarterGui"):SetCore("SendNotification",{Title="SOWXTEAM: COOLDOWN",Text=content,Duration=12})end)
        end
        warn(content)
        return true
    end
