        local migrated={}
        for key,value in pairs(values.AutoStatTargets)do
            if type(key)=="number"and type(value)=="string"then migrated[key]=previousLabels[value]or value
            else migrated[previousLabels[key]or key]=value end
        end
        values.AutoStatTargets=migrated
    end
    for _,id in ipairs({"Skills","CombatTypes","CombatLoadout","AutoStatTargets"}) do
        if type(values[id])=="table" then
            local clean={}
            for key,value in pairs(values[id]) do
                if type(key)=="number" and type(value)=="string" then
                    if values[id][value]==nil then clean[value]=true end
                elseif type(key)=="string" and type(value)=="boolean" then clean[key]=value end
            end
