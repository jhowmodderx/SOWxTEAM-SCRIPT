local function decodeBase64(encoded)
    local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local values={}
    for index=1,#alphabet do values[alphabet:sub(index,index)]=index-1 end
    assert(#encoded%4==0,"BASE64 INVALIDO")
    local chunks,buffer={},{}
    for index=1,#encoded,4 do
        local a,b,c,d=encoded:sub(index,index),encoded:sub(index+1,index+1),encoded:sub(index+2,index+2),encoded:sub(index+3,index+3)
        assert(values[a] and values[b] and (c=='=' or values[c]) and (d=='=' or values[d]),"BASE64 INVALIDO")
        local number=values[a]*262144+values[b]*4096+(values[c] or 0)*64+(values[d] or 0)
        local one,two,three=math.floor(number/65536)%256,math.floor(number/256)%256,number%256
        buffer[#buffer+1]=c=='=' and string.char(one) or d=='=' and string.char(one,two) or string.char(one,two,three)
        if #buffer>=2048 then chunks[#chunks+1]=table.concat(buffer);buffer={} end
        if index%65536==1 and index>1 then task.wait() end
    end
    if #buffer>0 then chunks[#chunks+1]=table.concat(buffer) end
    return table.concat(chunks)
end
