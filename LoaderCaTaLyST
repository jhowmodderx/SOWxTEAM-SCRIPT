        ["ALTA"]="alta",
        ["LENTO"]="lento",
        ["NORMAL"]="normal",
        ["RAPIDO"]="rápido",
        ["SUAVE"]="suave",
        ["ATRAS"]="atrás",
        ["ATRÁS"]="atrás",
        ["Atrás"]="atrás",
        ["atras"]="atrás",
        ["ACIMA"]="acima",
        ["FRENTE"]="frente",
        ["MAIS PROXIMO"]="mais próximo",
        ["TODAS AS ILHAS"]="todas as ilhas"
