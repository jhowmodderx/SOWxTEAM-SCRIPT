local function stableCombatPosition(enemyRoot)
    local signature=table.concat({tostring(state.position),tostring(state.height),tostring(state.distance)},":")
    local changed=movementTarget~=target or movementSignature~=signature
    local preferred=Vector3.new(0,state.height,state.distance)
    if state.position=="frente"then preferred=Vector3.new(0,state.height,-state.distance)
    elseif state.position=="acima"then preferred=Vector3.new(0,state.distance+state.height,0)end
    if changed then
        movementTarget,movementSignature=target,signature
        movementOffset=enemyRoot.CFrame:PointToWorldSpace(preferred)-enemyRoot.Position
        nextPositionCheck=0
    end
    if os.clock()>=(nextPositionCheck or 0)then
        nextPositionCheck=os.clock()+.25
        local char,_,root=character()
        local excluded={enemyRoot.Parent,combatProbe}
        if char then excluded[#excluded+1]=char end
        if workspace.CurrentCamera then excluded[#excluded+1]=workspace.CurrentCamera end
        local overlap=OverlapParams.new()
        overlap.FilterType=Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances=excluded
        overlap.RespectCanCollide=true
        local ray=RaycastParams.new()
        ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances=excluded
        ray.RespectCanCollide=true;ray.IgnoreWater=true
        local function clear(position)
            combatProbe.CFrame=CFrame.new(position)
            for _,part in ipairs(workspace:GetPartsInPart(combatProbe,overlap))do
                if part.CanCollide then return false end
            end
            local delta=enemyRoot.Position-position
            return delta.Magnitude<.1 or workspace:Raycast(position,delta,ray)==nil
        end
        local selected=enemyRoot.Position+movementOffset
        if not clear(selected)then
            local best,cost
            local radius=math.max(4,Vector3.new(preferred.X,0,preferred.Z).Magnitude)
            for _,candidateRadius in ipairs({radius,4,2.5,6})do
            for _,height in ipairs({movementOffset.Y,0,2,4})do
                for index=0,15 do
                    local angle=index*math.pi/8
                    local offset=Vector3.new(math.cos(angle)*candidateRadius,height,math.sin(angle)*candidateRadius)
                    local position=enemyRoot.Position+offset
                    if clear(position)then
                        local score=(offset-movementOffset).Magnitude+(root and(position-root.Position).Magnitude*.1 or 0)
                        if not cost or score<cost then best,cost=offset,score end
                    end
                end
            end
            end
            if best then movementOffset=best;state.combatPositionBlocked=false
            else
                state.combatPositionBlocked=true
                movementOffset=Vector3.new(0,math.max(6,state.distance+state.height),0)
            end
        else state.combatPositionBlocked=false end
    end
    return enemyRoot.Position+movementOffset
end
