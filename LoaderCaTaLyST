                shared.cache[url] = {time = os.clock(), data = data}
                return data
            elseif code == 429 then
                shared.streak = (shared.streak or 0) + 1
                local delay = ok and retryAfter(result.Headers) or nil
                delay = math.max(6, delay or math.min(300, 60 * 2 ^ math.min(shared.streak - 1, 3)))
                shared.nextAt = math.max(shared.nextAt, os.clock() + delay)
                status("Roblox limitou a busca (429). Nova consulta em " .. math.ceil(delay) .. " s")
