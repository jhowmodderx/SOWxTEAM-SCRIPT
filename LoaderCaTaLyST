                            if type(entry)=="table"and entry.PlaceId==game.PlaceId and isBrazil(entry.Location)then
                                data.data[#data.data+1]={id=entry.JobId,playing=entry.Players,maxPlayers=entry.MaxPlayers,location=entry.Location}
                            end
