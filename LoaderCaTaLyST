autoStats=(function()
    local labels={"força","resistência","espada","arma","fruta vox"}
    local keys={["força"]="Strength",["resistência"]="Endurance",["espada"]="Sword",["arma"]="Gun",["fruta vox"]="DevilFruit"}
    local selected,enabled,cursor={},false,0
    local utils,balancing,menu,pending
    local info={phase="DESLIGADO",available=0,sent=0,confirmed=0}
    local log=internalStatus({Title="Auto atributos",Content="DESLIGADO"})
    local section=farmSections.attributes
    section:AddToggle("AutoStats",{Title="Auto atributos",Default=false,Callback=function(value)enabled=value;info.phase=value and "AGUARDANDO PONTOS" or "DESLIGADO" end})
    section:AddDropdown("AutoStatTargets",{Title="Atributos",Values=labels,Multi=true,Default={},Callback=function(values)selected=values end})
    local function fingerprint(stats)
        local parts={tostring(stats.Level)}
        for _,label in ipairs(labels)do parts[#parts+1]=tostring(stats[keys[label]] or 1)end
        return table.concat(parts,":")
    end
    local function tick()
        if not state.alive then return end
        if not enabled and not pending then return end
        local modules=clientAPI()
        local data=modules.DataStore.IsClient:Get()
        local stats=data and data.Statistics
        if type(stats)~="table" then info.phase="AGUARDANDO DADOS";return end
        if pending then
            local confirmed=true
            for key,count in pairs(pending.plan)do
                if (tonumber(stats[key]) or 1)<pending.before[key]+count then confirmed=false;break end
            end
            if confirmed then info.confirmed=info.confirmed+pending.count;pending=nil
            elseif os.clock()-pending.time<10 then info.phase="AGUARDANDO CONFIRMACAO";return
            elseif fingerprint(stats)==pending.fingerprint then info.phase="SEM CONFIRMACAO; NOVO ENVIO SUSPENSO";return
            else info.phase="DADOS ALTERADOS; RECALCULANDO";pending=nil;return end
        end
        if not enabled then info.phase="DESLIGADO";return end
        if not utils then
            local replicated=game:GetService("ReplicatedStorage")
            local native=replicated.Modules.Essentials.StatisticsSystem["StatisticsSystem Client"].StatisticsMenu
            utils=require(native.Utils)
            menu=require(native)
            balancing=require(replicated.Shared.MainModules).BalancingFeatures
        end
        if menu and type(menu.TempStats)=="table" then
            for _,amount in pairs(menu.TempStats)do if type(amount)=="number" and amount>0 then info.phase="AGUARDANDO EDICAO MANUAL DOS ATRIBUTOS";return end end
        end
        local available=tonumber(utils.GetAvailablePoints({}))
        local maximum=balancing and tonumber(balancing.MaxLevel)
        if not available or available~=available or not maximum or maximum~=maximum or maximum<=0 then info.phase="AGUARDANDO LIMITES DO JOGO";return end
        available=math.max(0,math.floor(available));maximum=math.floor(maximum);info.available=available
        if available==0 then info.phase="AGUARDANDO PONTOS";return end
        local choices={}
        for _,label in ipairs(labels)do
            if selected[label] and (tonumber(stats[keys[label]]) or 1)<maximum then choices[#choices+1]=keys[label]end
        end
        if #choices==0 then info.phase="SELECIONE ATRIBUTOS ABAIXO DO LIMITE";return end
        local plan,before,total={},{},0
        for _,key in ipairs(choices)do before[key]=tonumber(stats[key]) or 1 end
        for _=1,math.min(available,#choices)do
            local found=false
            for _=1,#choices do
                cursor=cursor%#choices+1
                local key=choices[cursor]
                if not plan[key] and before[key]<maximum then plan[key]=1;total=total+1;found=true;break end
            end
            if not found then break end
        end
        if total==0 then info.phase="ATRIBUTOS NO LIMITE";return end
        pending={plan=plan,before=before,count=total,time=os.clock(),fingerprint=fingerprint(stats)}
        info.phase="AGUARDANDO CONFIRMACAO";info.sent=info.sent+total
        modules.Network:FireServer("StatisticsData","UpgradeStats",plan)
    end
    return {tick=function()tick();pcall(function()log:SetDesc(info.phase.." | PONTOS: "..tostring(info.available).." | CONFIRMADOS: "..tostring(info.confirmed))end)end,debug=function()return info end}
end)()
