stormController=(function()
    local warnings={}
    local fieldWarnings={}
    local function eligible()
        if not storyController.active()then return false end
        local info=storyController.debug()
        return info.eventQuest=="The Thunder Fist"and tostring(info.objective):find("Survive_RaijinStorm_FS",1,true)~=nil
    end
    local function active()
        if not eligible()then return false end
        local _,hum,root=character()
        if not root or not hum or hum.Health<=0 then return false end
        local now=workspace:GetServerTimeNow()
        for index=#fieldWarnings,1,-1 do
            local field=fieldWarnings[index]
            if field.expires<now then table.remove(fieldWarnings,index)
            else
                local delta=root.Position-field.center
                if math.abs(delta.Y)<=16 and delta.X*delta.X+delta.Z*delta.Z<=(field.radius+20)^2 then return true end
            end
        end
        return false
    end
    local function observe(data)
        if not eligible()or type(data)~="table"or type(data.Wires)~="table"then return end
        if typeof(data.Owner)~="Instance"or not data.Owner.Parent then return end
        for _,wire in ipairs(data.Wires)do
            if wire.Kind=="Circle"and typeof(wire.Center)=="Vector3"and type(wire.Radius)=="number"then
                fieldWarnings[#fieldWarnings+1]={center=wire.Center,radius=wire.Radius,expires=workspace:GetServerTimeNow()+8}
                warnings[#warnings+1]={center=wire.Center,radius=wire.Radius,
                    finish=(tonumber(data.At)or workspace:GetServerTimeNow())+(tonumber(wire.Hit)or 1.2)+(tonumber(wire.Active)or .15)+.2}
            end
        end
    end
    local api=require(game:GetService("ReplicatedStorage").Modules.Combat.EnemysSystem["EnemysSystem Client"].Telegraphs)
    local originalShow=api.Show
    local wrapped=function(data)pcall(observe,data);return originalShow(data)end
    api.Show=wrapped
    table.insert(connections,{Disconnect=function()if api.Show==wrapped then api.Show=originalShow end end})
    local function safe(point)
        for _,wire in ipairs(warnings)do
            local dx,dz=point.X-wire.center.X,point.Z-wire.center.Z
            if dx*dx+dz*dz<(wire.radius+4)^2 then return false end
        end
        return true
    end
    local function step(dt)
        if not eligible()then warnings={};fieldWarnings={};return false end
        if not active()then return false end
        local _,hum,root=character()
        if not root or not hum or hum.Health<=0 then return true end
        local now=workspace:GetServerTimeNow()
        for index=#warnings,1,-1 do if warnings[index].finish<now then table.remove(warnings,index)end end
        if safe(root.Position)then return true end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Include
        local geometry={workspace.Terrain};local map=workspace:FindFirstChild("Map")
        if map then geometry[#geometry+1]=map end
        params.FilterDescendantsInstances=geometry;params.IgnoreWater=false
        local destination
        for _,radius in ipairs({10,18,26,36,48,60})do
            for index=0,31 do
                local angle=index*math.pi/16
                local point=root.Position+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
                if safe(point)then
                    local hit=workspace:Raycast(point+Vector3.new(0,12,0),Vector3.new(0,-25,0),params)
                    if hit and hit.Material~=Enum.Material.Water and hit.Normal.Y>.65
                        and(not hit.Instance:IsA("BasePart")or hit.Instance.CanCollide)then
                        local grounded=hit.Position+Vector3.new(0,hum.HipHeight+root.Size.Y/2,0)
                        local wall=workspace:Raycast(root.Position,grounded-root.Position,params)
                        if not wall then destination=grounded;break end
                    end
                end
            end
            if destination then break end
        end
        if destination then
            local delta=destination-root.Position
            local distance=delta.Magnitude
            if distance>.01 then
                local point=root.Position+delta.Unit*math.min(distance,(state.travelSpeed or 270)*math.min(dt or .016,.05))
                root.CFrame=CFrame.new(point)*root.CFrame.Rotation
                root.AssemblyLinearVelocity=Vector3.zero
            end
        end
        return true
    end
    return {active=active,step=step}
end)()

