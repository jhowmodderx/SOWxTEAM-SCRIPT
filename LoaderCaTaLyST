        if wire.Kind=="Ring"then
            return distance<=(tonumber(wire.Radius)or 0)+margin and distance>=math.max(0,(tonumber(wire.InnerRadius)or 0)-margin)
        end
        local ux,uz=direction(wire)
        local lateral=math.abs(dx*(-uz)+dz*ux)
