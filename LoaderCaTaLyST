local function pickBoss()
    local _, hum, root = character()
    if not root or not hum or hum.Health <= 0 then return nil end
    local best, nearest = nil, math.huge
    for _, model in ipairs(cachedEnemies) do
        if model:GetAttribute("IsBoss") == true and valid(model) and (state.bossName == "mais próximo" or original(model) == state.bossName) then
            local distance = (root.Position - model.HumanoidRootPart.Position).Magnitude
            if distance < nearest then best, nearest = model, distance end
        end
    end
    if best then questPhase = "BOSS: " .. original(best);return best end
    local spawn, spawnDistance
    for name, position in pairs(bossPositions) do
        if state.bossName == "mais próximo" or name == state.bossName then
            local distance = (root.Position - position).Magnitude
            if not spawnDistance or distance < spawnDistance then spawn,spawnDistance=position,distance end
        end
    end
    if spawn and spawnDistance > 35 and not travel then beginTravel(spawn + Vector3.new(0,5,8), "SPAWN DO BOSS", "boss", locateIsland(spawn)) end
    questPhase = spawn and "AGUARDANDO RESPAWN/RENDER DO BOSS" or "BOSS NAO CARREGADO; VISITE A ILHA E ATUALIZE A LISTA"
end
